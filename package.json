{
  "name": "buckline",
  "version": "0.5.0",
  "private": true,
  "description": "Log scaling, grading and yield accounting for a hardwood sawmill",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "9.9.0",
    "globals": "15.9.0",
    "prettier": "3.3.3",
    "vitest": "2.0.5"
  },
  "bin": {
    "buckline": "bin/buckline.js"
  },
  "dependencies": {
    "commander": "12.1.0"
  },
  "files": [
    "bin",
    "src"
  ]
}
