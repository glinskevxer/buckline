{
  "name": "buckline",
  "version": "0.5.0",
  "private": true,
  "description": "Log scaling, grading and yield accounting for a hardwood sawmill",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run lint && npm run format:check && npm test && npm run smoke && npm run release:check",
    "release:check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  },
  "bin": {
    "buckline": "bin/buckline.js"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "files": [
    "bin",
    "src"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  }
}
