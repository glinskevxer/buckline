{
  "name": "buckline",
  "version": "1.0.0",
  "private": true,
  "description": "Log scaling, grading, bucking and settlement accounting for a hardwood sawmill",
  "keywords": [
    "sawmill",
    "forestry",
    "log-rule",
    "lumber-grading",
    "scaling",
    "timber"
  ],
  "license": "MIT",
  "author": "glinskevxer <roym78109@gmail.com>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "buckline": "bin/buckline.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run lint && npm run format:check && npm test && npm run smoke && npm run release:check",
    "release:check": "bash scripts/release-check.sh"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  }
}
